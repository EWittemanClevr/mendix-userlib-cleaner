{
  "_comment": "Test cases for the library analysis, kept implementation-neutral (a JavaScript implementation runs them too). Add a case when you fix a bug.",
  "java": [
    {
      "name": "imports, static, wildcard, qualified names; comments and strings ignored",
      "src": "package mymodule.actions;\nimport org.apache.commons.io.FileUtils;\nimport static org.apache.commons.lang3.StringUtils.isBlank;\nimport org.jsoup.*;\nimport java.util.List;\n// import com.fake.Commented;\nclass X { String s = \"com.fake.InString\"; void f() { new org.apache.poi.ss.usermodel.WorkbookFactory(); com.mendix.core.Core.getLogger(\"\"); } }",
      "types": ["com.mendix.core.Core", "org.apache.commons.io.FileUtils", "org.apache.commons.lang3.StringUtils", "org.apache.poi.ss.usermodel.WorkbookFactory"],
      "packages": ["org.jsoup"],
      "byName": ["com.fake.InString"]
    },
    {
      "name": "class names in strings are by-name references, unless also used as a type",
      "src": "class X { void f() { Class.forName(\"org.postgresql.Driver\"); String s = \"not.a.class\"; new org.x.y.Z(); String t = \"org.x.y.Z\"; } }",
      "types": ["org.x.y.Z"],
      "packages": [],
      "byName": ["org.postgresql.Driver"]
    },
    {
      "name": "javax.mail is a library, javax.crypto is the JDK",
      "src": "import javax.mail.Session;\nimport javax.crypto.Cipher;\nclass X {}",
      "types": ["javax.mail.Session"],
      "packages": [],
      "byName": []
    }
